# Frontend (public values, safe to ship in the bundle)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Edge Function secrets. NEVER put these in .env or in the frontend:
# set them in Supabase (Dashboard > Edge Functions > Secrets, or `supabase secrets set`).
# CRON_SECRET=
# ECOWITT_APPLICATION_KEY=
# ECOWITT_API_KEY=
